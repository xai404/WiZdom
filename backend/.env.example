# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/WiZdom

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# Default admin (used by the seed script only)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@wizdom.com
SEED_ADMIN_PASSWORD=ChangeMe123!
