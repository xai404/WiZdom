{
  "expo": {
    "name": "WiZdom",
    "slug": "wizdom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
   "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.appforwizdomsteam.wizdom"
},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e8f5ec",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.appforwizdomsteam.wizdom"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wizdom_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05190e",
          "dark": {
            "backgroundColor": "#05190e"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/wizdom_logo.png",
          "color": "#166534"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow WiZdom to add support contacts to your phone's address book."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fae3708-a1dd-4a3c-8276-9f0c98e61e50"
      }
    },
    "owner": "appforwizdoms-team"
  }
}
